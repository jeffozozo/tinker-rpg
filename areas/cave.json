      "trigger_type": "show_message",
      "name": "old_woman_request",
      "parameters": {
        "message": "The old woman says: \u201cHow did you find me? Never mind. Bring me the scepter of light\u2014a magic wand carried by a skeleton of the castle\u2014and I will give you the answer to the gargoyle\u2019s riddle. Step beside me when you have it.\u201d",
        "charges": 1
      },
      "enemy_attached": "",
      "enemy_defeated": false,
      "enemy_pending": false
    },
