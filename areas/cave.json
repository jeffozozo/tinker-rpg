      "x": 3,
      "y": 6,
      "trigger_type": "inventory",
      "name": "give_scepter",
      "parameters": {
        "remove": "magic_wand_object",
        "charges": 1
      },
      "enemy_attached": "",
      "enemy_defeated": false,
      "enemy_pending": false
    },
    {
      "x": 3,
      "y": 6,
      "trigger_type": "inventory",
      "name": "receive_answer_token",
      "parameters": {
        "add": "green_gem_object",
        "charges": 1
      },
      "enemy_attached": "",
      "enemy_defeated": false,
      "enemy_pending": false
    },
    {
      "x": 3,
      "y": 6,
      "trigger_type": "show_message",
      "name": "old_woman_answer",
      "parameters": {
        "message": "\u201cYour name is Keeper. Your quest is the crimson crown. Your color is green.\u201d She presses a green token into your palm. \u201cShow this to the gargoyle. There is another wand beneath the castle if you need one.\u201d",
        "charges": 1
      },
      "enemy_attached": "",
      "enemy_defeated": false,
      "enemy_pending": false
    }
